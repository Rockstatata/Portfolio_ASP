<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="admin_panel.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Portfolio Admin Panel</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Admin Styles -->
    <link href="~/Content/adminstyles.css" rel="stylesheet" type="text/css" />
    
    <!-- Dropdown Dark Mode Fixes -->
    <link href="~/Content/dropdown-dark.css" rel="stylesheet" type="text/css" />

    <!-- Small local styles for the new root button -->
    <style type="text/css">
        /* Small globe button placed in the admin nav actions */
        .admin-root-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            margin: 0 0.5rem;
            border-radius: 6px;
            background: transparent;
            border: 1px solid rgba(255,255,255,0.06);
            color: var(--text-secondary-dark);
            text-decoration: none;
            transition: all 0.15s ease;
            font-size: 0.95rem;
        }

        .admin-root-btn:hover,
        .admin-root-btn:focus {
            background: rgba(255,255,255,0.03);
            color: var(--color-primary);
            transform: translateY(-1px);
            outline: none;
        }

        /* Hide avatar and root button inside nav-actions on small screens to move them into mobile menu */
        @media (max-width: 899px) {
            .admin-nav-actions .admin-user-info,
            .admin-nav-actions .admin-root-btn {
                display: none;
            }
        }
    </style>

    <!-- Three.js and Vanta.js for animated background -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/gh/tengbao/vanta/dist/vanta.net.min.js"></script>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:BundleReference runat="server" Path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
</head>
<body class="admin-body">
    <!-- Vanta.js Background -->
    <div class="vanta-bg" id="vanta-bg"></div>

    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
            </Scripts>
        </asp:ScriptManager>

        <!-- Floating Navbar -->
        <div class="admin-navbar-container">
            <div class="admin-navbar-content">
                <div class="admin-navbar-flex">
                    <!-- Brand + Current Page -->
                    <div class="admin-navbar-brand">
                        <a href='<%=ResolveUrl("~/admin/") %>' class="admin-brand-dashboard-link <%=GetNavActiveClass("ManageHome.aspx") %>">
                            <i class="fas fa-chart-line brand-icon"></i>
                            <span class="brand-dashboard-text">Dashboard</span>
                        </a>
                    </div>

                    <!-- Desktop Navigation -->
                    <div class="admin-desktop-nav">
                        <a href='<%=ResolveUrl("~/admin/about") %>' class="admin-nav-link <%=GetNavActiveClass("ManageAbout.aspx") %>">
                            <i class="fas fa-user"></i><span class="nav-text">About</span>
                        </a>
                        <a href='<%=ResolveUrl("~/admin/projects") %>' class="admin-nav-link <%=GetNavActiveClass("ManageProjects.aspx") %>">
                            <i class="fas fa-briefcase"></i><span class="nav-text">Projects</span>
                        </a>
                        <a href='<%=ResolveUrl("~/admin/experience") %>' class="admin-nav-link <%=GetNavActiveClass("ManageExperiences.aspx") %>">
                            <i class="fas fa-building"></i><span class="nav-text">Experience</span>
                        </a>
                        <a href='<%=ResolveUrl("~/admin/skills") %>' class="admin-nav-link <%=GetNavActiveClass("ManageSkills.aspx") %>">
                            <i class="fas fa-code"></i><span class="nav-text">Skills</span>
                        </a>
                        <a href='<%=ResolveUrl("~/admin/timeline") %>' class="admin-nav-link <%=GetNavActiveClass("ManageTimeline.aspx") %>">
                            <i class="fas fa-clock"></i><span class="nav-text">Timeline</span>
                        </a>
                        <a href='<%=ResolveUrl("~/admin/blogs") %>' class="admin-nav-link <%=GetNavActiveClass("ManageBlogs.aspx") %>">
                            <i class="fas fa-blog"></i><span class="nav-text">Blogs</span>
                        </a>
                        <a href='<%=ResolveUrl("~/admin/contacts") %>' class="admin-nav-link <%=GetNavActiveClass("ManageContacts.aspx") %>">
                            <i class="fas fa-envelope"></i><span class="nav-text">Contacts</span>
                        </a>

                    </div>

                    <!-- User Actions -->
                    <div class="admin-nav-actions">
                        
                        <div class="admin-user-info">
                            <div class="admin-user-avatar">
                                <%= GetUserInitials() %>
                            </div>
                        </div>

                        <!-- Root site button (globe icon) -->
                        <a href='<%= ResolveUrl("~/") %>' class="admin-root-btn" title="View Site" aria-label="View Site">
                            <i class="fas fa-globe"></i>
                        </a>

                        <a href="<%= GetLogoutUrl() %>" class="admin-logout-btn">
                            <i class="fas fa-sign-out-alt"></i>
                        </a>

                        <!-- Mobile Menu Toggle -->
                        <button type="button" class="admin-mobile-menu-toggle" onclick="toggleMobileMenu(event)" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open navigation menu">
                            <i class="fas fa-bars"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Mobile Menu (moved outside admin-navbar-content so it isn't clipped by overflow:hidden) -->
            <div id="mobile-menu" class="admin-mobile-menu hidden" aria-hidden="true" role="menu">
                <div class="mobile-menu-content">
                    <a href='<%=ResolveUrl("~/admin/") %>' class="mobile-nav-link <%=GetNavActiveClass("ManageHome.aspx") %>" role="menuitem">
                        <i class="fas fa-home"></i>Dashboard
                    </a>
                    <a href='<%=ResolveUrl("~/admin/about") %>' class="mobile-nav-link <%=GetNavActiveClass("ManageAbout.aspx") %>" role="menuitem">
                        <i class="fas fa-user"></i>About
                    </a>
                    <a href='<%=ResolveUrl("~/admin/projects") %>' class="mobile-nav-link <%=GetNavActiveClass("ManageProjects.aspx") %>" role="menuitem">
                        <i class="fas fa-briefcase"></i>Projects
                    </a>
                    <a href='<%=ResolveUrl("~/admin/experience") %>' class="mobile-nav-link <%=GetNavActiveClass("ManageExperiences.aspx") %>" role="menuitem">
                        <i class="fas fa-building"></i>Experience
                    </a>
                    <a href='<%=ResolveUrl("~/admin/skills") %>' class="mobile-nav-link <%=GetNavActiveClass("ManageSkills.aspx") %>" role="menuitem">
                        <i class="fas fa-code"></i>Skills
                    </a>
                    <a href='<%=ResolveUrl("~/admin/timeline") %>' class="mobile-nav-link <%=GetNavActiveClass("ManageTimeline.aspx") %>" role="menuitem">
                        <i class="fas fa-clock"></i>Timeline
                    </a>
                    <a href='<%=ResolveUrl("~/admin/blogs") %>' class="mobile-nav-link <%=GetNavActiveClass("ManageBlogs.aspx") %>" role="menuitem">
                        <i class="fas fa-blog"></i>Blogs
                    </a>
                    <a href='<%=ResolveUrl("~/admin/contacts") %>' class="mobile-nav-link <%=GetNavActiveClass("ManageContacts.aspx") %>" role="menuitem">
                        <i class="fas fa-envelope"></i>Contacts
                    </a>

                    <!-- Divider -->
                    <div class="mobile-portfolio-link" style="margin-top:8px;">
                        <!-- Add avatar and root site link inside mobile menu for smaller screens -->
                        <div style="display:flex;align-items:center;gap:0.75rem;padding:0.5rem 0;">
                            <div class="admin-user-avatar" style="width:36px;height:36px;font-size:0.875rem;"> <%= GetUserInitials() %> </div>
                            <a href='<%= ResolveUrl("~/") %>' class="admin-root-btn" title="View Site" aria-label="View Site" style="width:auto;height:36px;padding:0.5rem;"> <i class="fas fa-globe"></i> <span style="margin-left:8px;">View Site</span></a>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="admin-main-content">
            <div class="admin-container">
                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>
            </div>
        </div>

        <!-- Admin Footer -->
        <footer class="admin-footer">
            <div class="admin-container">
                <div class="admin-footer-content">
                    <div class="admin-footer-brand">
                        <i class="fas fa-chart-line"></i>
                        <span>Portfolio Admin</span>
                    </div>

                    <div class="admin-footer-copyright">
                        <p>&copy; <%: DateTime.Now.Year %> Portfolio Admin Panel. All rights reserved.</p>
                    </div>
                </div>
            </div>
        </footer>
    </form>

    <script type="text/javascript">
        // Initialize Vanta.js background with proper configuration
        function initVantaBackground() {
            if (typeof VANTA === 'undefined' || typeof THREE === 'undefined') {
                setTimeout(initVantaBackground, 100);
                return;
            }

            try {
                // Destroy existing instance if any
                if (window.vantaEffect) {
                    window.vantaEffect.destroy();
                }

                // Check device capabilities
                const isMobile = window.innerWidth < 768;
                const isLowPerformance = navigator.hardwareConcurrency < 4 || navigator.deviceMemory < 4;

                window.vantaEffect = VANTA.NET({
                    el: "#vanta-bg",
                    mouseControls: !isMobile,
                    touchControls: isMobile,
                    gyroControls: false,
                    minHeight: 200.00,
                    minWidth: 200.00,
                    scale: isMobile ? 0.8 : 1.0,
                    scaleMobile: 0.7,
                    color: 0xd14d72, // Portfolio primary color
                    backgroundColor: 0x1a1625, // Portfolio background
                    points: isMobile || isLowPerformance ? 6 : 10,
                    maxDistance: isMobile ? 18 : 25,
                    spacing: isMobile ? 20 : 16,
                    showDots: !isMobile
                });

                console.log('✅ Vanta.js initialized successfully');
            } catch (error) {
                console.error('❌ Vanta.js initialization failed:', error);
                // Fallback background
                document.getElementById('vanta-bg').style.background =
                    'linear-gradient(135deg, #1a1625 0%, #2d1b4e 50%, #1a1625 100%)';
            }
        }

        // Fix dropdown styling for ASP.NET server controls
        function fixDropdownStyling() {
            // Get all select elements (including ASP.NET DropDownList)
            const dropdowns = document.querySelectorAll('select, .admin-form-select');
            
            dropdowns.forEach(function(dropdown) {
                // Force dark mode styling
                dropdown.style.backgroundColor = '#1a1625';
                dropdown.style.color = '#ffffff';
                dropdown.style.border = '1px solid rgba(255, 171, 171, 0.2)';
                
                // Apply styling to all options
                const options = dropdown.querySelectorAll('option');
                options.forEach(function(option) {
                    option.style.backgroundColor = '#1a1625';
                    option.style.color = '#ffffff';
                });
                
                // Add event listeners for hover effects
                dropdown.addEventListener('focus', function() {
                    this.style.borderColor = 'rgb(209, 77, 114)';
                    this.style.boxShadow = '0 0 0 3px rgba(209, 77, 114, 0.1)';
                });
                
                dropdown.addEventListener('blur', function() {
                    this.style.borderColor = 'rgba(255, 171, 171, 0.2)';
                    this.style.boxShadow = 'none';
                });
            });
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function () {
            initVantaBackground();
            fixDropdownStyling();
        });

        // Also run after any postback (for ASP.NET WebForms)
        function pageLoad() {
            fixDropdownStyling();
        }

        // Resize handler
        window.addEventListener('resize', function () {
            if (window.vantaEffect && typeof window.vantaEffect.resize === 'function') {
                window.vantaEffect.resize();
            }
        });

        // Toggle mobile menu
        function toggleMobileMenu(e) {
            // Prevent click from bubbling to document and immediately closing the menu
            if (e && e.stopPropagation) e.stopPropagation();

            const menu = document.getElementById('mobile-menu');
            const toggle = document.querySelector('.admin-mobile-menu-toggle');

            if (menu) {
                menu.classList.toggle('hidden');

                // Update aria attributes
                const isOpen = !menu.classList.contains('hidden');
                if (toggle) toggle.setAttribute('aria-expanded', isOpen);
                menu.setAttribute('aria-hidden', !isOpen);

                // Close on click outside
                if (isOpen) {
                    // add listener on next event loop tick to avoid immediate close
                    setTimeout(function() { document.addEventListener('click', closeMobileMenuOnOutsideClick); }, 0);
                } else {
                    document.removeEventListener('click', closeMobileMenuOnOutsideClick);
                }
            }
        }

        function closeMobileMenuOnOutsideClick(e) {
            const menu = document.getElementById('mobile-menu');
            const toggle = document.querySelector('.admin-mobile-menu-toggle');

            if (!menu || !toggle) return;

            // If the click target is not inside the menu or the toggle, close it
            if (!menu.contains(e.target) && !toggle.contains(e.target)) {
                menu.classList.add('hidden');
                toggle.setAttribute('aria-expanded', 'false');
                menu.setAttribute('aria-hidden', 'true');
                document.removeEventListener('click', closeMobileMenuOnOutsideClick);
            }
        }
    </script>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>
</body>
</html>